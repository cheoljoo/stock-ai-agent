# AI 제공자 선택: openrouter(기본값) | gemini | claude
# openrouter는 OpenRouter API를 직접 호출한다(기본 모델이 :free라 과금 없음).
# gemini/claude는 로컬 계정 구독 기반 agy CLI를 통해 호출되어 과금이 없다.
AI_PROVIDER=openrouter

# gemini/claude(agy) 또는 openrouter가 인식하는 정확한 모델명을 직접 지정하고
# 싶을 때만 설정 (미설정 시 provider별 기본값 사용)
# 예: gemini-3.1-pro-high, claude-sonnet-4-6, minimax/minimax-m3:free
# AI_MODEL_ID=gemini-3.1-pro-high

# agy CLI 응답 대기 제한 시간(초)
# AI_CLI_TIMEOUT=300

# AI_PROVIDER=openrouter 를 사용할 때 필요 (https://openrouter.ai/keys 에서 발급)
# OPENROUTER_API_KEY=sk-or-v1-...

# Telegram 알림용 설정 (stock_sim.telegram, notify_telegram_analysis.py)
# @BotFather (https://t.me/BotFather) 에게 "/newbot"을 보내 발급받은 토큰
# TELEGRAM_BOT_TOKEN=xxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 메시지를 받을 채팅 ID(=관리자). 봇과 먼저 대화한 뒤
# https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates 로 확인
# TELEGRAM_CHAT_ID=123456789

# telegram_bot.py 승인 목록: TELEGRAM_CHAT_ID(관리자) 외에 봇 사용을 허용할
# chat_id를 콤마로 나열. 승인 대기 중인 사용자가 봇에게 메시지를 보내면
# 관리자에게 chat_id가 안내되며, 여기에 추가하면 재시작 없이 즉시 승인된다.
# TELEGRAM_APPROVED_CHAT_IDS=111111111,222222222

# 카카오톡 "나에게 보내기" 설정 (stock_sim.kakao, notify_telegram_analysis.py)
# 둘 다 없으면 카카오 전송은 자동으로 건너뛴다. 설정 방법은
# stock-sim-template의 docs/KAKAO_SETUP.md 참고.
# https://developers.kakao.com 에서 앱 생성 후 "카카오 로그인" 활성화 +
# Redirect URI 등록, 동의항목에서 talk_message 활성화
# KAKAO_REST_API_KEY=...
# KAKAO_REDIRECT_URI=https://example.com/oauth
# stock-sim-template의 examples/get_kakao_token.py 로 최초 1회 발급
# KAKAO_REFRESH_TOKEN=...
# "카카오 로그인 > 보안"에서 Client Secret을 활성화한 앱만 필요
# KAKAO_CLIENT_SECRET=...
