# AI 제공자 선택: openrouter(기본값) | gemini | claude
# openrouter는 OpenRouter API를 직접 호출한다(기본 모델이 :free라 과금 없음).
# gemini/claude는 로컬 계정 구독 기반 agy CLI를 통해 호출되어 과금이 없다.
AI_PROVIDER=openrouter

# gemini/claude(agy) 또는 openrouter가 인식하는 정확한 모델명을 직접 지정하고
# 싶을 때만 설정 (미설정 시 provider별 기본값 사용)
# 예: gemini-3.1-pro-high, claude-sonnet-4-6, minimax/minimax-m3:free
# AI_MODEL_ID=gemini-3.1-pro-high

# agy CLI 응답 대기 제한 시간(초)
# AI_CLI_TIMEOUT=300

# AI_PROVIDER=openrouter 를 사용할 때 필요 (https://openrouter.ai/keys 에서 발급)
# OPENROUTER_API_KEY=sk-or-v1-...
